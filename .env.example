# 复制为 .env 并填写。所有密钥只走环境变量，不入库、不上传。

# 数据根目录（替代 Google Drive 的 /content/drive/MyDrive/SAGAI）
SAGAI_BASE=./data

# 百度地图开放平台 AK（全景静态图 API），多个用英文逗号分隔做轮换
# 申请：https://lbsyun.baidu.com/ （建议企业认证提配额）
BAIDU_AK=your_baidu_ak_1,your_baidu_ak_2

# 天地图服务 key（交互地图底图，CGCS2000 有审图号）
# 申请：https://console.tianditu.gov.cn/
TIANDITU_TK=your_tianditu_tk

# 阿里云百炼 API Key（路线 B：无 GPU 时的云推理）
# 申请：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# Overpass 端点（可换国内可达镜像；或不用此项、走本地路网/离线 pbf）
OVERPASS_URL=https://overpass-api.de/api/interpreter

# 模型权重本地目录
SAGAI_MODELS=./models
